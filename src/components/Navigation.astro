---
import BrandIcon from './marketing/BrandIcon.astro';
import Logo from './Logo.astro';
import Menu from 'lucide-astro/Menu';
import X from 'lucide-astro/X';
import ChevronRight from 'lucide-astro/ChevronRight';
import Sun from 'lucide-astro/Sun';
import Moon from 'lucide-astro/Moon';
const links = [
  { href: '/#features', label: 'Features' },
  { href: '/#showcase', label: 'Product' },
  { href: '/#pricing', label: 'Pricing' },
  { href: '/#security', label: 'Security' },
  { href: '/docs', label: 'Docs' },
  { href: '/philosophy', label: 'Philosophy' },
  { href: '/sponsorships', label: 'Sponsors' },
  { href: 'https://coollabs.io/discord', label: 'Community' },
  { href: '/#faq', label: 'FAQ' },
];
const GITHUB = 'https://github.com/coollabsio/shoutrrr';
const CLOUD = 'https://app.shoutrrr.com';
---

<header
  data-scrolled="false"
  class="sticky top-0 z-50 border-b border-transparent bg-[var(--nav-bg)] backdrop-blur-lg backdrop-saturate-150 transition-[border-color,box-shadow] duration-300 ease-out data-[scrolled=true]:border-line data-[scrolled=true]:shadow-sm"
>
  <nav
    class="mx-auto flex max-w-site items-center justify-between gap-6 px-5 py-3 sm:px-6 sm:py-3.5"
  >
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2.5 text-ink no-underline">
      <Logo class="h-[30px] w-[30px] text-lime" />
      <span class="text-[18px] font-bold -tracking-[0.01em]">Shoutrrr</span>
    </a>

    <!-- Desktop links -->
    <div class="hidden items-center gap-5 text-sm text-ink-500 lg:flex">
      {
        links
          .filter((l) => l.label !== 'FAQ')
          .map((l) => (
            <a href={l.href} class="no-underline transition-colors hover:text-ink">
              {l.label}
            </a>
          ))
      }
    </div>

    <!-- Actions -->
    <div class="flex items-center gap-2 sm:gap-3">
      <a
        href={GITHUB}
        class="press hidden items-center gap-1.5 rounded-[9px] px-3 py-2 text-sm font-medium text-ink-700 no-underline transition-colors hover:bg-surface-sunken sm:inline-flex"
        ><BrandIcon name="github" class="h-[18px] w-[18px]" /> GitHub</a
      >
      <a
        href={CLOUD}
        class="press rounded-[9px] border border-lime-ring bg-lime px-3.5 py-2 text-sm font-semibold text-lime-deep no-underline transition-[filter] hover:brightness-[1.04] sm:px-4"
        >Get started</a
      >
      <button
        id="theme-toggle"
        type="button"
        class="relative grid size-9 place-items-center rounded-[9px] text-ink-700 transition-colors hover:bg-surface-sunken"
        aria-label="Toggle dark mode"
        aria-pressed="false"
      >
        <Sun id="icon-sun" class="size-[18px] dark:hidden" />
        <Moon id="icon-moon" class="absolute hidden size-[18px] dark:block" />
      </button>
      <!-- Mobile toggle -->
      <button
        id="menu-toggle"
        class="relative grid size-9 place-items-center rounded-[9px] text-ink transition-colors hover:bg-surface-sunken lg:hidden"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <Menu id="icon-menu" class="size-6" />
        <X id="icon-close" class="absolute hidden size-6" />
      </button>
    </div>
  </nav>

  <!-- Mobile menu (animated height) -->
  <div
    id="mobile-menu"
    data-open="false"
    class="grid grid-rows-[0fr] transition-[grid-template-rows] duration-300 ease-out data-[open=true]:grid-rows-[1fr] lg:hidden"
  >
    <div class="overflow-hidden">
      <nav class="flex flex-col gap-0.5 border-t border-line px-4 pb-5 pt-3">
        {
          links.map((l) => (
            <a
              href={l.href}
              class="flex items-center justify-between rounded-xl px-3 py-3 text-[15px] font-medium text-ink-700 no-underline transition-colors hover:bg-surface-sunken active:bg-surface-sunken"
            >
              {l.label}
              <ChevronRight class="size-4 text-ink-300" />
            </a>
          ))
        }
        <div class="mt-3 grid grid-cols-2 gap-2 border-t border-line pt-4">
          <a
            href={GITHUB}
            class="press inline-flex items-center justify-center gap-2 rounded-xl border border-line-strong bg-surface px-4 py-3 text-sm font-semibold text-ink-700 no-underline transition-colors hover:bg-surface-sunken"
            ><BrandIcon name="github" class="h-[18px] w-[18px]" /> GitHub</a
          >
          <a
            href={CLOUD}
            class="press inline-flex items-center justify-center rounded-xl border border-lime-ring bg-lime px-4 py-3 text-sm font-semibold text-lime-deep no-underline transition-[filter] hover:brightness-[1.04]"
            >Get started</a
          >
        </div>
      </nav>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconMenu = document.getElementById('icon-menu');
  const iconClose = document.getElementById('icon-close');

  const themeToggle = document.getElementById('theme-toggle');
  const themeMeta = document.getElementById('theme-color-meta');

  function paintTheme(isDark: boolean) {
    themeToggle?.setAttribute('aria-pressed', String(isDark));
    themeMeta?.setAttribute('content', isDark ? '#343434' : '#ffffff');
  }

  // Sync button/meta to the class the inline head script already applied.
  paintTheme(document.documentElement.classList.contains('dark'));

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  let themeFadeTimer: ReturnType<typeof setTimeout> | undefined;

  // Briefly enable a global color transition so the dark↔light flip eases
  // instead of snapping. Scoped in time (~260ms) so nothing else pays for it.
  function withThemeFade(apply: () => void) {
    const root = document.documentElement;
    if (reduceMotion.matches) {
      apply();
      return;
    }
    root.classList.add('theme-transition');
    apply();
    if (themeFadeTimer) clearTimeout(themeFadeTimer);
    themeFadeTimer = setTimeout(() => root.classList.remove('theme-transition'), 260);
  }

  themeToggle?.addEventListener('click', () => {
    withThemeFade(() => {
      const isDark = document.documentElement.classList.toggle('dark');
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
      paintTheme(isDark);
    });
  });

  // Follow the OS while the user hasn't picked an explicit theme.
  window
    .matchMedia('(prefers-color-scheme: dark)')
    .addEventListener('change', (e) => {
      if (localStorage.getItem('theme')) return;
      withThemeFade(() => {
        document.documentElement.classList.toggle('dark', e.matches);
        paintTheme(e.matches);
      });
    });

  // Scroll-edge divider: the translucent bar floats borderless at the top and
  // only grows a divider + faint shadow once content scrolls beneath it.
  const header = document.querySelector('header');
  const setScrolled = () =>
    header?.setAttribute('data-scrolled', String(window.scrollY > 8));
  setScrolled();
  window.addEventListener('scroll', setScrolled, { passive: true });

  function setOpen(open: boolean) {
    if (!menu || !toggle) return;
    menu.setAttribute('data-open', String(open));
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    iconMenu?.classList.toggle('hidden', open);
    iconClose?.classList.toggle('hidden', !open);
  }

  toggle?.addEventListener('click', () => {
    setOpen(menu?.getAttribute('data-open') !== 'true');
  });
  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => setOpen(false));
  });
  // Close when resizing up to the desktop breakpoint.
  window.matchMedia('(min-width: 1024px)').addEventListener('change', (e) => {
    if (e.matches) setOpen(false);
  });
</script>
